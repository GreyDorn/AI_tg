[Unit]
Description=Telegram AI Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/tg_AI
EnvironmentFile=/root/tg_AI/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/tg_AI/venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
