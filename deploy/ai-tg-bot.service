[Unit]
Description=Telegram AI Bot (aiogram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/AI_tg
EnvironmentFile=/opt/AI_tg/.env
ExecStart=/usr/bin/python3 /opt/AI_tg/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
