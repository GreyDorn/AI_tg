[Unit]
Description=AI GPT MAX Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ai-gpt-max
EnvironmentFile=/opt/ai-gpt-max/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ai-gpt-max/venv/bin/python max_main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
