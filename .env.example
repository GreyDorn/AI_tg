BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini (free: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (free: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (free: https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Re-check OpenRouter credits every N seconds (default 1800 = 30 min)
OPENROUTER_PROBE_INTERVAL=1800

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Pollinations (music: https://enter.pollinations.ai)
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Admin Telegram user_id
ADMIN_ID=123456789

# Daily bonus reminders (UTC hour, e.g. 9 = 09:00 UTC)
DAILY_REMINDER_ENABLED=true
DAILY_REMINDER_HOUR_UTC=9

# Payments, credits, referrals (false = bot is free for everyone)
MONETIZATION_ENABLED=false

# --- LLM Gateway (DE VPS) ---
GATEWAY_INTERNAL_KEY=generate_a_long_random_secret_here
GATEWAY_PORT=8788

# --- MAX bot (RU VPS) ---
MAX_BOT_TOKEN=your_max_bot_token_here
MAX_API_URL=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=your_webhook_secret_5_to_256_chars
MAX_WEBHOOK_URL=https://vpoiskerabot.ru/ai-gpt/webhook
MAX_BOT_PORT=8090
LLM_GATEWAY_URL=http://151.243.180.58:8788
DATABASE_URL=sqlite+aiosqlite:///max_bot.db

# Auto-post promo to Telegram channel (bot must be channel admin)
CHANNEL_POST_ENABLED=false
PROMO_CHANNEL_ID=@your_channel_username
CHANNEL_POST_INTERVAL=86400
